{
	"name": "harugon/cloudflare-mail",
	"type": "mediawiki-extension",
	"description": "MediaWiki extension that sends wiki email through Cloudflare Email Service",
	"license": "MIT",
	"require": {
		"php": ">=8.1",
		"ext-iconv": "*",
		"ext-json": "*",
		"ext-mbstring": "*"
	},
	"require-dev": {
		"guzzlehttp/guzzle": "^7.8",
		"mediawiki/mediawiki-codesniffer": "48.0.2",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0",
		"pear/mail_mime": "^1.10",
		"phpunit/phpunit": "^9.6",
		"psr/log": "^1.1 || ^2.0 || ^3.0"
	},
	"autoload-dev": {
		"psr-4": {
			"MediaWiki\\Extension\\CloudflareMail\\": "src/",
			"MediaWiki\\Extension\\CloudflareMail\\Tests\\": "tests/phpunit/"
		}
	},
	"scripts": {
		"test": [
			"parallel-lint . --exclude vendor --exclude node_modules",
			"@phpcs",
			"@phpunit"
		],
		"phpunit": "phpunit",
		"phpcs": "phpcs -sp --cache",
		"fix": "phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
